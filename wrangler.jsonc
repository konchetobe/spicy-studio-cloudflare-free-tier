{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spicy-studio-cloudflare-free-tier",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spicy-studio-cloudflare-free-tier",
      "database_id": "279ae1c3-087e-4e58-aff7-103de2e20643",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AUTH", "class_name": "AuthDO" },
      { "name": "TASKS", "class_name": "TaskPoller" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthDO", "TaskPoller"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_ORIGIN": "https://spicy-studio-cloudflare-free-tier.kondiowenka.workers.dev",
    "SPICYMODELS_BASE_URL": "https://spicymodels.ai/api/v1",
    "RUNWARE_BASE_URL": "https://api.runware.ai/v1",
    "RUNWARE_MODEL": "deepseek:v4.1@flash-1017"
  }
}
